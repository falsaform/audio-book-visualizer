# Copy to `.env` and fill in. The CLI loads this automatically.

# Used for text analysis: characters, scenes, visual descriptions.
ANTHROPIC_API_KEY=sk-ant-...

# Used for image (still-frame) generation via DALL-E, and optionally
# for audio transcription via the OpenAI transcription API.
OPENAI_API_KEY=sk-...

# Optional: authenticates the Claude Code CLI inside the container
# (`just claude`). Generate one on a machine with Claude Code installed via
# `claude setup-token`. In CI, export it as an environment variable instead.
CLAUDE_CODE_OAUTH_TOKEN=
