# Copy to `.env` and fill in. The CLI loads this automatically.
#
# Text analysis needs ONE of the two Claude credentials below:
#   - ANTHROPIC_API_KEY (raw API key), or
#   - CLAUDE_CODE_OAUTH_TOKEN (Claude Code subscription token; routed through
#     the bundled `claude` CLI, no API key required).
# If both are set, the API key is used. Image generation needs OPENAI_API_KEY.

# Claude API key for text analysis (characters, scenes, visual descriptions).
# Leave blank if you only have a Claude Code token (below).
ANTHROPIC_API_KEY=

# Image generation. Set the one matching generation.provider in config:
#   - OPENAI_API_KEY for DALL-E (also used for OpenAI audio transcription)
#   - GEMINI_API_KEY for Google Gemini 2.5 Flash Image ("Nano Banana")
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=

# Claude Code subscription token. Powers text analysis when ANTHROPIC_API_KEY
# is unset, and authenticates the `just claude` CLI. Generate it on a machine
# with Claude Code via `claude setup-token`. In CI, export it as an env var.
CLAUDE_CODE_OAUTH_TOKEN=
